{
  "name": "zetruv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.js",
    "build": "vite build",
    "build:storefront": "vite build",
    "build:admin": "vite build --config vite.admin.config.js",
    "build:storefront:dev": "vite build --mode dev",
    "build:admin:dev": "vite build --config vite.admin.config.js --mode dev",
    "build:all:dev": "npm run build:storefront:dev && npm run build:admin:dev",
    "preview": "vite preview",
    "preview:admin": "vite preview --config vite.admin.config.js",
    "build:storefront:staging": "vite build --mode staging",
    "build:admin:staging": "vite build --config vite.admin.config.js --mode staging",
    "build:all:staging": "npm run build:storefront:staging && npm run build:admin:staging",
    "test:cart": "node --test src/services/cartService.test.mjs",
    "prebuild:storefront:dev": "npm run test:cart && npm run test:checkout && npm run test:service && npm run test:payment",
    "test:checkout": "node --test src/services/digitalCheckoutRules.test.mjs",
    "test:service": "node --test src/services/digitalServiceAvailability.test.mjs",
    "test:payment": "node --test src/services/paymentSession.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {}
}
